# --- Data runtime (jangan pernah ikut ke repo) ---
# Isi folder data/ milik tiap instalasi, bukan kode: hash password admin,
# daftar PWA beserta target link-nya, statistik, dan sisa berkas migrasi
# (*.migrated) yang masih memuat semuanya.
# Seluruh isi diabaikan, kecuali .htaccess yang memang bagian dari proteksi.
data/*
!data/.htaccess

# Ikon hasil upload pengguna
uploads/icons/*
!uploads/icons/.gitkeep

# Berkas kosong sisa editor; router memakai index.php
index.html

# Sisa berkas pengujian (cookie jar curl, dsb)
*.cookies
cookies*.txt

# --- Sistem & editor ---
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.log
*.bak
*~
